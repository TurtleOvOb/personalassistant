/* --- 笔记模块搜索框 --- */
#input_Search_2 {
    /* 15/255 的微弱黑色透明，形成浅灰色效果 */
    background-color: rgba(0, 0, 0, 15); 
    border: 1px solid #D1D1D6;
    border-radius: 4px;
    color: #333333;
    padding: 4px;
}

#input_Search_2:hover {
    background-color: rgba(0, 0, 0, 25);
    border: 1px solid #C7C7CC;
}

/* --- 笔记标题输入框 --- */
#input_Notetitle {
    background-color: transparent;
    border: none;
    /* 浅色模式下建议加粗标题文字，增强视觉重心 */
    font-weight: bold;
    font-size: 16px;
    color: #1C1C1E;
    border-radius: 4px;
}

#input_Notetitle:focus {
    /* 聚焦时可以给个极其微弱的底色，提示正在编辑 */
    background-color: #F2F2F7;
}

/* --- 笔记正文/描述区域 --- */
#input_Note {
    background-color: transparent;
    /* 将深色底边改为浅灰色 */
    border: none;
    border-bottom: 1px solid #D1D1D6;
    color: #333333;
    line-height: 1.5; /* 增加行高提升阅读体验 */
}

#input_Note:focus {
    /* 聚焦时底边变为品牌蓝色 */
    border-bottom: 2px solid #007AFF;
}